@model IEnumerable<SSD_Lab1.Models.BoardMessage>
@{ ViewData["Title"] = "Message board"; }
<h1>Message board</h1>
<p>Signed-in users can post a message. Messages cannot be edited or deleted.</p>
<form asp-action="Create" method="post" class="mb-4">
    <div class="mb-3"><label class="form-label" for="Content">Your message</label><textarea class="form-control" id="Content" name="Content" rows="3" maxlength="1000" required></textarea><span class="text-muted">Maximum 1,000 characters.</span><span class="text-danger">@Html.ValidationMessage("Content")</span></div>
    <button type="submit" class="btn btn-primary">Post message</button>
</form>
@if (!Model.Any())
{
    <p class="text-muted">No messages have been posted yet.</p>
}
else
{
    foreach (var item in Model)
    {
        <article class="card mb-3"><div class="card-body"><p class="card-text" style="white-space: pre-wrap">@item.Content</p><p class="card-subtitle text-muted">@item.AuthorName · @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</p></div></article>
    }
}
