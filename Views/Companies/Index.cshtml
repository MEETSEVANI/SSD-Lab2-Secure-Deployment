@model IEnumerable<SSD_Lab1.Models.Company>

@{
    ViewData["Title"] = "Companies";
}

<h1>Companies</h1>

@if (User.IsInRole("Supervisor"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create new company</a>
    </p>
}
else
{
    <p class="text-muted">Employees can view company information but cannot create, edit, or delete records.</p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.YearsInBusiness)</th>
            <th>@Html.DisplayNameFor(model => model.Website)</th>
            <th>@Html.DisplayNameFor(model => model.Province)</th>
            <th><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.YearsInBusiness)</td>
            <td><a href="@item.Website" rel="noopener noreferrer" target="_blank">@item.Website</a></td>
            <td>@Html.DisplayFor(modelItem => item.Province)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole("Supervisor"))
                {
                    <text> | </text><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
